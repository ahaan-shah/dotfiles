[Unit]
Description=Watchdog for the BAT0 charge cap

# Why a watchdog and not just "set it once": the cap is enforced by the EC, and
# the EC drops it silently. sysfs keeps reading the correct number — it is only
# asus-wmi's cache of the last value written, never a question put to the EC —
# so nothing short of watching what the pack actually does reveals it. Known
# triggers: resume from suspend/hibernate (the cached value survives while the
# EC has reset), and an upstream asus-wmi issue where asus_wmi_set_devstate()
# fails to reach the EC with no error reported.
#
# Why it re-asserts rather than only reacting: on 2026-09-09 a 90% cap ended the
# session at 100%. The old check only acted when sysfs disagreed with the saved
# value, or when capacity was already 2% over AND status still read "Charging" —
# and neither holds during the failure that matters. sysfs agrees (it is a
# cache), and the EC stops reporting "Charging" well before the pack is full
# while still filling it. So --check re-arms the cap on a schedule whenever the
# machine is on AC, and gates the alarm on AC rather than on the status string.
#
# Why THIS unit is also the resume hook, which is not obvious from its name.
# On 2026-09-11 the same cap reached 100% again after a hibernate, with every
# mechanism firing correctly — hypridle's after_sleep_cmd one second after the
# resume, this watchdog twenty seconds later, both logging a clean re-assert.
# A sysfs write does not reliably re-latch the cap in an EC that has been
# powered down and re-initialised. So --check now also detects time it cannot
# account for (a gap much larger than this interval means it was not running:
# suspend, hibernate, power-off, or a restart of this timer) and hands off to
# --resume, which uses a far stronger stimulus and then PROBES the EC to find
# out whether it worked. See scripts/apply-battery-threshold.sh note 4.
#
# That lost-time trick is here because there is nowhere better to put it: this
# is a USER unit, and systemd 261 exposes sleep.target, suspend.target and
# hibernate.target to the SYSTEM manager only — the user manager reports them
# not-found — while /usr/lib/systemd/system-sleep is root-owned and so belongs
# to install.sh rather than to a per-user config. hypridle's after_sleep_cmd
# calls --resume directly and gets there first when it is running; this covers
# it being toggled off, which Ahaan does deliberately (Always Awake).
#
# 1 minute is comfortably tight: charging 80% -> 100% takes far longer, so a
# lapse is caught well before it meaningfully overcharges. The routine re-arm is
# throttled to once every 3 minutes inside the script, and the probe — the only
# expensive check, since it briefly interrupts charging to get its answer — is
# reserved for resumes, AC-connects, and once every 5 minutes while a fault is
# actually standing. So this interval costs one sysfs read a minute in the
# common case.
#
# Note this is a MONOTONIC timer, so the clock does not advance while suspended
# and the first post-resume run can be up to a minute late. That is fine for the
# same reason — and the lost-time detector above reads the WALL clock precisely
# so that a late first run is still recognised as a resume rather than missed.
# (Persistent= is deliberately absent — it only affects OnCalendar timers and
# would do nothing here.)

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=15s

[Install]
WantedBy=timers.target
